---
import type { GetStaticPaths } from "astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/sheet/PageIntro.astro";
import PostRows from "@/components/sheet/PostRows.astro";
import { siteConfig } from "@/consts";
import { getPosts, getTags, tagSlug } from "@/lib/posts";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	return getTags(posts).map((tag) => ({
		params: { tag: tagSlug(tag) },
		props: { name: tag, posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === tagSlug(tag))) },
	}));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name} · Writing · ${siteConfig.title}`}>
	<PageIntro label="1 Application notes — by tag" title={`#${name}`}>
		<p><a class="link" href="/writing">← All writing</a></p>
	</PageIntro>
	<section>
		<PostRows posts={posts} />
	</section>
</BaseLayout>

<style>
	section {
		padding: var(--block) var(--gutter);
	}
</style>
