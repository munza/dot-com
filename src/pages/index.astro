---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import Section from "@/components/layout/Section.astro";
import PostList from "@/components/PostList.astro";
import { getPosts } from "@/lib/posts";

const latestPosts = (await getPosts()).slice(0, 5);
---

<BaseLayout title="Home">
	<Header slot="header" />
	<p><em>I build the backend systems people only notice when they break.</em></p>
	<p>
		Ten years across logistics, payments and public transport. These days I work on order processing at a grocery
		delivery company, and write here about what I learn running it.
	</p>

	<Section id="about" title="How I work">
		<ol>
			<li><strong>Boring technology first.</strong> Postgres and a queue go further than you think.</li>
			<li><strong>Small, reversible steps.</strong> Feature flags and dual writes over big-bang migrations.</li>
			<li><strong>Quiet on-call.</strong> Alerts that page only when a customer is affected.</li>
		</ol>
	</Section>

	<Section id="latest" title="Latest posts">
		<PostList posts={latestPosts} />
		<p><a href="/blog">All posts →</a></p>
	</Section>
	<Footer slot="footer" />
</BaseLayout>
