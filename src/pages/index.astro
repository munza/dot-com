---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRows from "@/components/sheet/PostRows.astro";
import ProjectGrid from "@/components/sheet/ProjectGrid.astro";
import SectionHead from "@/components/sheet/SectionHead.astro";
import TalkRows from "@/components/sheet/TalkRows.astro";
import Icon from "@/components/ui/Icon.astro";
import {
	authorInfo,
	careerStartYear,
	headline,
	homeSections,
	method,
	nowHighlight,
	pages,
	roles,
	socialLinks,
	talks,
	talkTopics,
	yearsInSoftware,
} from "@/consts";
import { getPosts, getProjects } from "@/lib/posts";
import { numberWord } from "@/lib/words";

const posts = await getPosts();
const projects = await getProjects();
const companies = new Set(roles.map((role) => role.company)).size;
const profiles = socialLinks.filter((link) => link.href.startsWith("http"));

// § numbers count only the sections that are shown, so hiding one never leaves a gap.
const numbered = (["description", "characteristics", "method", "projects", "writing", "talks"] as const).filter(
	(key) => key === "description" || homeSections[key],
);
const num = (key: (typeof numbered)[number]) => numbered.indexOf(key) + 1;
---

<BaseLayout title={pages.home.title} description={pages.home.description}>
	<section class:list={["hero", { split: homeSections.characteristics }]}>
		<div class="pitch">
			<p class="sec">§{num("description")} General description</p>
			<p class="caption eyebrow">Backend engineer · Amsterdam</p>
			<h1 class="display">{headline}</h1>
			<p class="intro">
				{numberWord(yearsInSoftware, { capitalize: true })} years across travel, payments, logistics and subscriptions. I care about event-driven architecture,
				domain-driven design, and software that’s easy to operate.
			</p>
			<div class="actions">
				<a class="btn-solid" href={`mailto:${authorInfo.email}`}>Say hello <Icon icon="arrow-up-right" aria-hidden="true" /></a>
				<a class="btn" href="/writing">Read the writing <Icon icon="arrow-right" aria-hidden="true" /></a>
			</div>
		</div>
		{homeSections.characteristics && (
		<div class="specs">
			<p class="sec bar">§{num("characteristics")} Characteristics</p>
			<dl class="kv">
				<div>
					<dt>Current</dt>
					<dd>{authorInfo.designation}, <a href={authorInfo.companyUrl}>{authorInfo.company}</a></dd>
				</div>
				<div><dt>Shipping software</dt><dd>{yearsInSoftware} yrs · since {careerStartYear}</dd></div>
				<div><dt>Companies</dt><dd>{companies} · startup → enterprise</dd></div>
				<div><dt>Cities</dt><dd>Dhaka → Berlin → Eindhoven → Amsterdam</dd></div>
				<div><dt>Domains</dt><dd>Travel · Payments · Logistics · Subscriptions · Lending</dd></div>
				<div><dt>Roles</dt><dd>IC · Tech lead · Eng. manager</dd></div>
				<div>
					<dt>Writing · Talks</dt>
					<dd><a href="/writing">{posts.length} posts</a> · <a href="/talks">{talks.length} talks</a></dd>
				</div>
				<div><dt>Location</dt><dd>Amsterdam · CET</dd></div>
				<div class="hl">
					<dt>Contact</dt>
					<dd><a href={`mailto:${authorInfo.email}`}>{authorInfo.email}</a></dd>
				</div>
				<div class="hl">
					<dt>Profiles</dt>
					<dd>
						{
							profiles.map((link, i) => (
								<>
									{i > 0 && " · "}
									<a href={link.href}>{link.label}</a>
								</>
							))
						}
					</dd>
				</div>
			</dl>
		</div>
		)}
	</section>

	{homeSections.now && (
	<a class="now" href="/now">
		<span class="caption">NOW</span>
		<span><span class="led live" aria-hidden="true"></span> {nowHighlight}</span>
		<span class="caption more">See what else I’m up to →</span>
	</a>
	)}

	{homeSections.method && (
	<section id="method">
		<div class="block-head">
			<SectionHead label={`${num("method")} Thesis & method`}><p>How I work</p></SectionHead>
		</div>
		<div class="split">
			<div class="cell">
				<p class="caption small">THESIS</p>
				<p class="thesis">{method.thesis}</p>
			</div>
			<div class="cell context"><p>{method.context}</p></div>
		</div>
		<ol class="steps">
			{
				method.steps.map((step, i) => (
					<li>
						<span class="n">{num("method")}.{i + 1}</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))
			}
		</ol>
		<figure>
			<figcaption class="caption">Fig. 1 — How a request becomes a fact</figcaption>
			<div class="flow">
				<div class="node">Inbound adapter<small>HTTP · CLI · consumer</small></div>
				<span class="arrow" aria-hidden="true">→</span>
				<div class="core">
					<small>DOMAIN CORE</small>
					<div>
						<div class="node">Aggregate</div>
						<div class="node">Domain event</div>
					</div>
				</div>
				<span class="arrow" aria-hidden="true">→</span>
				<div class="node">Outbox<small>same transaction</small></div>
				<span class="arrow" aria-hidden="true">→</span>
				<div class="node ink">Event stream<small>at-least-once</small></div>
			</div>
		</figure>
	</section>
	)}

	{homeSections.projects && (
	<section id="projects" class="block">
		<SectionHead label={`${num("projects")} Modules — projects`}>
			<div class="legend">
				<span><span class="led" aria-hidden="true"></span>IN PROGRESS</span>
				<span><span class="led planned" aria-hidden="true"></span>PLANNED</span>
			</div>
		</SectionHead>
		<p class="lede">Tools and products I’m building, in the order they ship. Each one comes from a problem I kept solving by hand.</p>
		<ProjectGrid projects={projects} />
	</section>
	)}

	{homeSections.writing && (
	<section id="writing" class="block">
		<SectionHead label={`${num("writing")} Application notes — writing`}>
			<div><a class="link" href="/writing">ALL POSTS →</a><a class="link" href="/rss.xml">RSS</a></div>
		</SectionHead>
		<p class="lede">Notes on backend architecture, developer tooling and engineering teams.</p>
		<PostRows posts={posts.slice(0, 5)} />
	</section>
	)}

	{homeSections.talks && (
	<section id="talks" class="split">
		<div class="cell">
			<p class="sec">§{num("talks")} Talks</p>
			<p class="talks-line">
				{numberWord(talks.length, { capitalize: true })} conference talks, mostly on Elixir and functional programming.
			</p>
			<p class="caption small topics">TOPICS I’D PROPOSE NEXT</p>
			<div>{talkTopics.map((topic) => <span class="chip">{topic}</span>)}</div>
			<p class="lede organise">
				Organising a meetup or conference? <a class="link" href={`mailto:${authorInfo.email}`}>{authorInfo.email}</a>
			</p>
		</div>
		<div class="cell talk-rows"><TalkRows /></div>
	</section>
	)}
</BaseLayout>

<style>
	section,
	.now {
		border-bottom: 1px solid var(--theme-rule);
	}

	section:last-child {
		border-bottom: none;
	}

	.block,
	.cell {
		padding: var(--block) var(--gutter);
	}

	.block-head {
		padding: 20px var(--gutter) 12px;
		border-bottom: 1px solid var(--theme-rule);
	}

	.lede {
		margin-bottom: 24px;
	}

	/* §1 + §2 */
	.pitch {
		display: flex;
		flex-direction: column;
		padding: clamp(32px, 5vw, 64px) var(--gutter);
	}

	.pitch .sec {
		margin-bottom: 24px;
	}

	.eyebrow {
		margin-bottom: 14px;
		font-size: 13px;
	}

	/* The home headline is the largest .display on the site. */
	h1 {
		max-width: none;
		font-size: clamp(38px, 4.8vw, 68px);
		line-height: 1.02;
	}

	.intro {
		max-width: 52ch;
		margin-top: 28px;
		font-size: 17px;
		line-height: 1.65;
		color: var(--theme-text);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 36px;
		margin-top: auto;
	}

	.specs {
		min-width: 0;
	}

	.bar {
		padding: 20px 24px;
		border-bottom: 1px solid var(--theme-rule);
	}

	.kv {
		font-size: 15px;
	}

	.kv .hl {
		background: var(--theme-panel);
	}

	.kv .hl dt {
		font-weight: 500;
		color: var(--theme-foreground);
	}

	/* Now band */
	.now {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		align-items: baseline;
		padding: 18px var(--gutter);
		font-size: 15px;
		text-decoration: none;
		background: var(--theme-panel);
	}

	.now:hover {
		color: inherit;
	}

	.now:hover .more {
		color: var(--theme-accent);
	}

	.more {
		margin-left: auto;
	}

	/* §3 */
	.small {
		margin-bottom: 16px;
		font-size: 11px;
	}

	.thesis {
		font-size: clamp(26px, 3vw, 38px);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.context {
		display: flex;
		align-items: flex-end;
		font-size: 18px;
		line-height: 1.6;
		color: var(--theme-text);
	}

	.context p {
		max-width: 46ch;
	}

	#method .split {
		border-bottom: 1px solid var(--theme-rule);
	}

	/* 4 → 2 → 1 columns, so the four steps never break 3 + 1. */
	.steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	@media (max-width: 1000px) {
		.steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.steps li:nth-child(2n) {
			border-right: none;
		}
	}

	@media (max-width: 560px) {
		.steps {
			grid-template-columns: minmax(0, 1fr);
		}

		.steps li {
			border-right: none;
		}
	}

	.steps li {
		padding: 28px clamp(20px, 3vw, 32px) 32px;
		margin-bottom: -1px;
		border-right: 1px solid var(--theme-rule);
		border-bottom: 1px solid var(--theme-rule);
		transition: background-color 0.25s ease;
	}

	.steps li:last-child {
		border-right: none;
	}

	.steps li:hover {
		background: var(--theme-hover);
	}

	.steps li:hover .n {
		color: var(--theme-accent);
	}

	.n {
		display: block;
		margin-bottom: 36px;
		font-family: var(--theme-font-mono);
		font-size: 12px;
		color: var(--theme-muted);
		transition: color 0.25s ease;
	}

	h3 {
		margin-bottom: 8px;
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.steps p {
		font-size: 15px;
		line-height: 1.55;
		color: var(--theme-text);
	}

	figure {
		padding: 32px var(--gutter) 40px;
		border-top: 1px solid var(--theme-rule);
	}

	figcaption {
		margin-bottom: 20px;
	}

	.flow {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		align-items: center;
		font-family: var(--theme-font-mono);
		font-size: 13px;
	}

	.node {
		display: flex;
		flex: 1 1 140px;
		flex-direction: column;
		gap: 2px;
		padding: 18px 16px;
		text-align: center;
		border: 1px solid var(--theme-foreground);
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.node:hover {
		color: var(--theme-accent);
		background: var(--theme-accent-tint);
		border-color: var(--theme-accent);
	}

	.node small,
	.core small {
		font-size: 11px;
		color: var(--theme-muted);
	}

	.node.ink {
		color: var(--theme-on-ink);
		background: var(--theme-foreground);
	}

	.node.ink small {
		color: var(--theme-dot);
	}

	.core {
		display: flex;
		flex: 2 1 260px;
		flex-direction: column;
		gap: 10px;
		padding: 14px;
		border: 1px dashed var(--theme-faint);
	}

	.core > div {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.core .node {
		flex-basis: 100px;
		padding: 14px 12px;
	}

	.arrow {
		color: var(--theme-muted);
	}

	/* §4 */
	.legend {
		font-size: 11px;
	}

	.legend > span {
		display: flex;
		gap: 6px;
		align-items: center;
	}

	/* §6 */
	.talks-line {
		max-width: 24ch;
		margin-top: 24px;
		font-size: clamp(22px, 2.2vw, 28px);
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.topics {
		margin-top: 28px;
		margin-bottom: 10px;
	}

	.organise {
		max-width: 40ch;
		margin: 20px 0 0;
		font-size: 15px;
	}

	.talk-rows {
		min-width: 0;
		padding-inline: clamp(12px, 2vw, 24px);
	}
</style>
