---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/sheet/PageIntro.astro";
import { siteConfig } from "@/consts";
---

<BaseLayout title={`Page not found · ${siteConfig.title}`}>
	<PageIntro label="404 Error" title="exit 1: that page doesn’t exist.">
		<p>The page you’re looking for moved or never existed.</p>
		<p><a class="btn" href="/">Back home →</a></p>
	</PageIntro>
</BaseLayout>
