---
import type { GetStaticPaths } from "astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import PostList from "@/components/PostList.astro";
import { getPosts, getTags, tagSlug } from "@/lib/posts";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	return getTags(posts).map((tag) => ({
		params: { tag: tagSlug(tag) },
		props: { name: tag, posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === tagSlug(tag))) },
	}));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
---

<BaseLayout title={`Posts tagged #${name}`}>
	<Header slot="header" />
	<h1>#{name}</h1>
	<p><a href="/blog">← All posts</a></p>
	<PostList posts={posts} />
	<Footer slot="footer" />
</BaseLayout>
