---
import Icon from "@/components/ui/Icon.astro";
---

<button id="scroll-to-top" type="button" aria-label="Scroll to top" hidden>
	<Icon icon="arrow-up" aria-hidden="true" />
</button>

<style>
	button {
		position: fixed;
		right: 16px;
		bottom: 16px;
		z-index: 40;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		cursor: pointer;
		color: var(--theme-foreground);
		background: var(--theme-sheet);
		border: 1px solid var(--theme-foreground);
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	button[hidden] {
		display: none;
	}

	button:hover {
		color: var(--theme-on-ink);
		background: var(--theme-foreground);
	}

	button :global(svg) {
		width: 18px;
		height: 18px;
	}
</style>

<script>
	// Looked up on each call because ClientRouter replaces the button on navigation.
	function updateVisibility() {
		const button = document.getElementById("scroll-to-top");
		if (button) button.hidden = window.scrollY < 300;
	}

	window.addEventListener("scroll", updateVisibility, { passive: true });
	document.addEventListener("astro:page-load", updateVisibility);

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Element) || !event.target.closest("#scroll-to-top")) return;
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
	});
</script>
