---
import Icon from "@/components/ui/Icon.astro";
import { navLinks, type NavLink } from "@/consts";

interface Props {
	links?: NavLink[];
	ariaLabel?: string;
	label?: string;
}

const { links = navLinks, ariaLabel = "Main navigation", label } = Astro.props;

// Hash links (/#about) are never "current"; path links match their own subpages too.
function isCurrent(href: string): boolean {
	if (href.includes("#") || href.startsWith("http")) return false;
	const path = Astro.url.pathname.replace(/\/$/, "") || "/";
	const target = href.replace(/\/$/, "") || "/";
	return target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
}
---

<nav aria-label={ariaLabel}>
	{label && <strong>{label}: </strong>}
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
						{link.icon && <Icon icon={link.icon} aria-hidden="true" />}{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
