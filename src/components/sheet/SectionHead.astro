---
interface Props {
	/** Section label without the "§", e.g. "3 Thesis & method". */
	label: string;
}

const { label } = Astro.props;
---

<div class="head">
	<p class="sec">§{label}</p>
	<slot />
</div>

<style>
	.head {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 8px;
	}

	.head > :global(:not(.sec)) {
		display: flex;
		gap: 20px;
		font-family: var(--theme-font-mono);
		font-size: 12px;
		color: var(--theme-muted);
	}
</style>
