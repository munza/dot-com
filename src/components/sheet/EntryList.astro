---
import type { Entry } from "@/consts";

interface Props {
	entries: Entry[];
}

const { entries } = Astro.props;
---

<dl>
	{
		entries.map((entry) => (
			<div>
				<dt>{entry.label.toUpperCase()}</dt>
				<dd>{entry.value}</dd>
			</div>
		))
	}
</dl>

<style>
	dl {
		font-size: 15px;
		line-height: 1.6;
	}

	div {
		display: grid;
		grid-template-columns: 140px minmax(0, 1fr);
		gap: 16px;
		padding: 14px 0;
		border-bottom: 1px dashed var(--theme-dash);
	}

	div:last-child {
		border-bottom: none;
	}

	dt {
		padding-top: 2px;
		font-family: var(--theme-font-mono);
		font-size: 12px;
		color: var(--theme-muted);
	}

	@media (max-width: 520px) {
		div {
			grid-template-columns: minmax(0, 1fr);
			gap: 4px;
		}
	}
</style>
