---
import Navigation from "@/components/layout/Navigation.astro";
import { tagSlug } from "@/lib/posts";

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

<Navigation links={tags.map((tag) => ({ label: `#${tag}`, href: `/blog/tags/${tagSlug(tag)}/` }))} ariaLabel="Tags" label="Tags" />
