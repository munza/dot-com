<button type="button" aria-pressed="false" data-theme-toggle>
	dark mode? <span class="dark:hidden">no.</span><span class="hidden dark:inline">yes.</span>
</button>

<script>
	function updateToggles() {
		const isDark = document.documentElement.classList.contains("dark");
		document.querySelectorAll("[data-theme-toggle]").forEach((toggle) => {
			toggle.setAttribute("aria-pressed", String(isDark));
		});
	}

	// Delegated so it keeps working after ClientRouter swaps the page.
	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) return;
		const isDark = document.documentElement.classList.toggle("dark");
		updateToggles();
		try {
			localStorage.setItem("theme", isDark ? "dark" : "light");
		} catch {
			// Storage blocked: the choice lasts until the next full page load.
		}
	});
	document.addEventListener("astro:page-load", updateToggles);
</script>
