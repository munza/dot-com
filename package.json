{
  "name": "dot-com",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "type-check": "astro check",
    "check": "oxlint && astro check && oxfmt --check .",
    "fix": "oxlint --fix && oxfmt --write",
    "test": "npm run build && node --test",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/source-serif-4": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.4.0",
    "satori": "^0.26.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "wrangler": "4.152.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.73.0"
  },
  "overrides": {
    "undici@7": "^7.30.1"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261019.1": true
  }
}
